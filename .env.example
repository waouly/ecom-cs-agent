# 默认全部走离线 mock，无需任何 Key 即可跑通全链路。
# 配好下面两项并设置 ECOM_CS_LLM_PROVIDER=openai 即可切真实模型。

ECOM_CS_LLM_PROVIDER=mock
# ECOM_CS_LLM_PROVIDER=openai
# ECOM_CS_LLM_MODEL=deepseek-chat
# ECOM_CS_LLM_BASE_URL=https://api.deepseek.com/v1
# ECOM_CS_LLM_API_KEY=sk-xxx

# 向量化：hashing（离线默认）| bge（需 sentence-transformers）
ECOM_CS_EMBED_PROVIDER=hashing

# 向量库：memory（默认）| milvus（需 pymilvus）
ECOM_CS_VECTOR_BACKEND=memory
# ECOM_CS_MILVUS_URI=http://localhost:19530

# 风险控制
ECOM_CS_CONFORMAL_ALPHA=0.05
ECOM_CS_DEFAULT_THRESHOLD=0.62
