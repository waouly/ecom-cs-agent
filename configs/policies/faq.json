      "effective_to": null,
      "priority": 5,
      "keywords": ["优惠券", "券退回", "券没了", "不能用券"]
    },
    {
      "clause_id": "FAQ-003",
      "title": "如何联系人工客服",
      "text": "在线客服工作时间为每天 9 点至 22 点，可点击会话窗口的「转人工」按钮接入；22 点后可留言，次日 9 点前按顺序回拨。",
